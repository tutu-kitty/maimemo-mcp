# ---- Authentication --------------------------------------------------------
# Maimemo Open API token.
# Get it in the app: 我的 → 更多设置 → 实验功能 → 开放 API
# Optional in http mode if MAIMEMO_REQUIRE_CLIENT_TOKEN=true.
MAIMEMO_API_TOKEN=

# Require every MCP client to supply its own token via `Authorization: Bearer`.
# Recommended when the deployment is shared by multiple people.
# Defaults to true when MAIMEMO_API_TOKEN is empty.
MAIMEMO_REQUIRE_CLIENT_TOKEN=false

# ---- Transport -------------------------------------------------------------
# "http" (Streamable HTTP + legacy SSE) or "stdio" (local clients).
MAIMEMO_MCP_TRANSPORT=http
PORT=3000
HOST=0.0.0.0

# ---- Reliability -----------------------------------------------------------
MAIMEMO_REQUEST_TIMEOUT_MS=20000
MAIMEMO_MAX_RETRIES=3

# Client-side throttling, format "<window><s|m|h>:<max requests>".
MAIMEMO_RATE_LIMITS=10s:20,60s:40,5h:2000

# ---- Advanced --------------------------------------------------------------
# MAIMEMO_API_BASE_URL=https://open.maimemo.com/open/
LOG_LEVEL=info
