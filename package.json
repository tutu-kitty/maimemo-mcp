{
  "name": "maimemo-mcp",
  "version": "2.1.0",
  "description": "MCP server that lets AI assistants call the 墨墨背单词 (Maimemo) Open API — vocabulary, notes, interpretations, phrases, notepads, and study data.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "maimemo-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tutu-kitty/maimemo-mcp.git"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "start:stdio": "MAIMEMO_MCP_TRANSPORT=stdio node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run build",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist/maimemo-mcp.cjs"
  },
  "keywords": [
    "mcp",
    "maimemo",
    "墨墨背单词",
    "model-context-protocol",
    "streamable-http",
    "vocabulary"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
