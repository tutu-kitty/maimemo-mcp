# systemd unit for running maimemo-mcp directly with Node (no Docker).
#
#   sudo cp deploy/maimemo-mcp.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now maimemo-mcp
#   sudo systemctl status maimemo-mcp
#   journalctl -u maimemo-mcp -f

[Unit]
Description=Maimemo MCP Server
Documentation=https://github.com/tutu-kitty/maimemo-mcp
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=maimemo
Group=maimemo
WorkingDirectory=/opt/maimemo-mcp
EnvironmentFile=/opt/maimemo-mcp/.env
ExecStart=/usr/bin/node /opt/maimemo-mcp/dist/index.js
Restart=always
RestartSec=5

# Token-health bookkeeping lives outside the project tree: ProtectHome=true
# makes the default XDG location unwritable, and without this the tool would
# silently fail to record a baseline on every start.
StateDirectory=maimemo-mcp
Environment=MAIMEMO_TOKEN_STATE_DIR=/var/lib/maimemo-mcp

# Logs go to the journal.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=maimemo-mcp

# ---- Hardening -------------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/maimemo-mcp
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryMax=256M

[Install]
WantedBy=multi-user.target
